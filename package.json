{
	"name": "zot-goe",
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "biome ci .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "astro check",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.4.1",
		"glightbox": "^3.3.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.11",
		"@biomejs/biome": "^2.5.15",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "4.155.0"
	},
	"lint-staged": {
		"*.{astro,ts,tsx,js,jsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
}

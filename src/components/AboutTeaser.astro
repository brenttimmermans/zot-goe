---
import EditorialLink from './ui/EditorialLink.astro';
import MonoLabel from './ui/MonoLabel.astro';
import Photo from './ui/Photo.astro';
---

<section class="mx-auto mt-section max-w-7xl px-page">
  <div
    class="grid gap-10 border-t border-line pt-10 md:grid-cols-[300px_1fr] md:gap-[60px]"
  >
    <Photo
      heightClass="h-[340px]"
      alt="Portret van Brent Timmermans"
      caption="portret van brent"
    />
    <div class="flex flex-col items-start gap-5">
      <MonoLabel accent>Over</MonoLabel>
      <p class="font-serif text-[1.3125rem] leading-relaxed text-heading">
        Ik ben Brent — fotograaf in Gent. Ik maak reportagebeelden van events,
        concerten en motorsport.
      </p>
      <p class="font-serif text-base leading-relaxed text-body-soft">
        Geen geposeerde momenten, wel wat er echt gebeurt. Ik loop discreet mee
        en fotografeer de sfeer, de actie en de mensen ertussen.
      </p>
      <EditorialLink href="/about" variant="underline">Lees verder</EditorialLink>
    </div>
  </div>
</section>

---
import { NAV_LINKS } from '../constants/site';
import ThemeToggle from './Theme/Toggle.astro';
import Wordmark from './ui/Wordmark.astro';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
}
---

<nav
	class="sticky top-0 z-50 h-(--navbar-height) bg-bg/80 backdrop-blur-sm"
>
	<div
		class="mx-auto flex h-full max-w-7xl items-center justify-between px-page"
	>
		<Wordmark size="nav" href="/" />
		<div class="flex items-center gap-8">
			{
				NAV_LINKS.map((link) => (
					<a
						href={link.href}
						class={`font-mono text-xs uppercase tracking-[0.06em] transition-colors ${
							isActive(link.href)
								? 'text-accent'
								: 'text-nav-link hover:text-accent'
						}`}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
			<ThemeToggle />
		</div>
	</div>
</nav>

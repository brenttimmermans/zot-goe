---
import { CONTACT_EMAIL } from '~/config';
import { SOCIALS } from '~/constants/site';

const year = new Date().getFullYear();
---

<footer
	class="flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-hairline px-gutter py-7 text-caption text-muted"
>
	<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	{SOCIALS.map(({ label, href }) => <a {href}>{label}</a>)}
	<span>Gent · © {year}</span>
</footer>

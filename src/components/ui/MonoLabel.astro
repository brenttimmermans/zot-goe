---
interface Props {
	accent?: boolean;
	as?: 'span' | 'div' | 'p';
	class?: string;
}

const { accent = false, as: Tag = 'span', class: className = '' } = Astro.props;
const color = accent ? 'text-accent' : 'text-muted';
const classes = `font-mono text-[0.6875rem] uppercase tracking-[0.12em] ${color} ${className}`;
---

<Tag class={classes}><slot /></Tag>

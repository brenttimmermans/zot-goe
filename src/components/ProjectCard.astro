---
import type { CollectionEntry } from 'astro:content';
import MonoLabel from './ui/MonoLabel.astro';
import Photo from './ui/Photo.astro';

interface Props {
	project: CollectionEntry<'projects'>;
	index?: number;
	heightClass?: string;
	offsetClass?: string;
	metaStyle?: 'inline' | 'stacked';
	class?: string;
}

const {
	project,
	index = 0,
	heightClass = 'h-[420px]',
	offsetClass = '',
	metaStyle = 'inline',
	class: className = '',
} = Astro.props;

const { title, description, category, location, date, cover } = project.data;

const number = String(index + 1).padStart(2, '0');
const year = date.getFullYear();
const stackedMeta = [category, location, year].filter(Boolean).join(' · ');
---

<a href={`/projects/${project.id}`} class={`group block ${offsetClass} ${className}`}>
  <Photo
    src={cover}
    alt={title}
    heightClass={heightClass}
    class="transition-opacity group-hover:opacity-90"
  />
  {
    metaStyle === 'inline' ? (
      <div class="mt-3.5 flex items-baseline justify-between gap-4">
        <MonoLabel>
          {number} / {title}
        </MonoLabel>
        <MonoLabel>
          {category} · {year}
        </MonoLabel>
      </div>
    ) : (
      <div class="mt-4 flex flex-col gap-2">
        <h3 class="text-lg font-bold tracking-[-0.01em] text-heading">{title}</h3>
        <p class="font-serif text-base leading-relaxed text-body-soft">
          {description}
        </p>
        <MonoLabel>{stackedMeta}</MonoLabel>
      </div>
    )
  }
</a>

---
import ProjectCard from '~/components/Project/ProjectCard.astro';
import { buildHighlightColumns, pickHighlights } from '~/lib/highlights';
import { getFeaturedProjects, getProjects } from '~/lib/projects';
import HighlightColumns from './HighlightColumns.astro';
import Intro from './Intro.astro';

const projects = await getProjects();
const highlights = pickHighlights(projects);
const columns = buildHighlightColumns(highlights);
const [lead] = await getFeaturedProjects();
---

<section
	class="flex flex-col gap-gutter pt-2 md:grid md:grid-cols-2 md:items-start"
>
	<div class="contents md:flex md:flex-col md:gap-[60px]">
		<HighlightColumns columns={columns.slice(0, 2)} priority />
		<Intro class="-order-1 pt-section-S pb-5 md:order-none md:p-0 md:px-gutter" />
	</div>
	<div class="flex flex-col gap-gutter">
		<HighlightColumns columns={columns.slice(2)} />
		{
			lead && (
				<ProjectCard
					project={lead}
					frameClass="aspect-[3/2]"
					sizes="(min-width: 768px) 50vw, 100vw"
					showYear
					labelClass="max-md:px-gutter"
				/>
			)
		}
	</div>
</section>

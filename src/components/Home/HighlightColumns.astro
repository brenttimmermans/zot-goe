---
import Photo from '~/components/Common/Photo.astro';
import type { Highlight } from '~/lib/highlights';

interface Props {
	columns: Highlight[][];
	priority?: boolean;
}

const { columns, priority = false } = Astro.props;
---

<div class="grid grid-cols-2 items-start gap-gutter">
	{
		columns.map((column, columnIndex) => (
			<div class="flex flex-col gap-gutter">
				{column.map(({ project, photo }, index) => (
					<a href={`/werk/${project.id}`} class="group">
						<Photo
							src={photo.src}
							alt={photo.alt ?? project.data.title}
							sizes="(min-width: 768px) 23vw, 50vw"
							fit="natural"
							priority={priority && columnIndex === 0 && index === 0}
							class="transition-colors group-hover:bg-frame-hover [&_img]:transition-opacity group-hover:[&_img]:opacity-90"
						/>
					</a>
				))}
			</div>
		))
	}
</div>

---
import Photo from '~/components/Common/Photo.astro';
import LightboxLink from '~/components/Project/LightboxLink.astro';
import type { Highlight } from '~/lib/highlights';

interface Props {
	columns: Highlight[][];
	firstNumber: number;
	total: number;
	priority?: boolean;
}

const { columns, firstNumber, total, priority = false } = Astro.props;
const highlights = columns.flat();

function numberOf(highlight: Highlight): number {
	return firstNumber + highlights.indexOf(highlight);
}
---

<div class="grid grid-cols-2 items-start gap-3">
	{
		columns.map((column, columnIndex) => (
			<div class="flex flex-col gap-3">
				{column.map((highlight, index) => {
					const { project, photo } = highlight;
					const alt = photo.alt ?? project.data.title;

					return (
						<LightboxLink
							src={photo.src}
							{alt}
							number={numberOf(highlight)}
							{total}
							class="group"
						>
							<Photo
								src={photo.src}
								{alt}
								sizes="(min-width: 768px) 23vw, 50vw"
								fit="natural"
								priority={priority && columnIndex === 0 && index === 0}
								class="transition-colors group-hover:bg-frame-hover [&_img]:transition-opacity group-hover:[&_img]:opacity-90"
							/>
						</LightboxLink>
					);
				})}
			</div>
		))
	}
</div>

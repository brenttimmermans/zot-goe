---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	sizes: string;
	fit?: 'cover' | 'natural';
	loading?: 'lazy' | 'eager';
	priority?: boolean;
	class?: string;
}

const WIDTHS = [480, 800, 1200, 1600, 2400];

const {
	src,
	alt,
	sizes,
	fit = 'cover',
	loading = 'lazy',
	priority = false,
	class: className,
} = Astro.props;

const maxWidth = Math.min(src.width, WIDTHS[WIDTHS.length - 1]);
const widths = [...WIDTHS.filter((width) => width < maxWidth), maxWidth];
---

<div class:list={['overflow-hidden bg-frame', className]}>
	<Picture
		src={src}
		alt={alt}
		sizes={sizes}
		widths={widths}
		formats={['avif']}
		fallbackFormat="webp"
		loading={priority ? undefined : loading}
		priority={priority}
		class:list={[fit === 'cover' ? 'size-full object-cover' : 'h-auto w-full']}
	/>
</div>

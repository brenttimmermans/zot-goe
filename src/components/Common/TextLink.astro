---
interface Props {
	href: string;
	variant?: 'underline' | 'plain';
	size?: 'sm' | 'lg';
	arrow?: boolean;
	class?: string;
}

const {
	href,
	variant = 'underline',
	size = 'sm',
	arrow = false,
	class: className,
} = Astro.props;

// The text-* utility outranks the global a:hover rule, so hover re-states it.
const VARIANT_CLASSES: Record<NonNullable<Props['variant']>, string> = {
	underline:
		'border-b border-ink pb-[3px] text-ink hover:border-accent hover:text-accent',
	plain: 'text-subtle hover:text-accent',
};

const SIZE_CLASSES: Record<NonNullable<Props['size']>, string> = {
	sm: 'text-sm',
	lg: 'text-title font-medium',
};
---

<a
	{href}
	class:list={[
		'transition-colors',
		SIZE_CLASSES[size],
		VARIANT_CLASSES[variant],
		className,
	]}
	><slot />{arrow && <span aria-hidden="true"> →</span>}</a
>

---
interface Props {
	type?: 'submit' | 'button';
	class?: string;
}

const { type = 'button', class: className } = Astro.props;
---

<button
	{type}
	class:list={[
		'cursor-pointer rounded-full bg-ink px-6 py-[13px] text-sm font-medium text-bg transition-colors hover:bg-accent hover:text-on-accent',
		className,
	]}
>
	<slot />
</button>

---
import TextLink from '~/components/Common/TextLink.astro';
import type { Project } from '~/lib/projects';

interface Props {
	next: Project;
}

const { next } = Astro.props;
---

<div
	class="flex flex-col items-start gap-8 px-gutter py-section-L md:flex-row md:items-baseline md:justify-between"
>
	<a href={`/werk/${next.id}`} class="flex flex-col gap-1.5">
		<span class="text-caption text-muted">Volgend project</span>
		<span class="text-title font-medium"
			>{next.data.title} <span aria-hidden="true">→</span></span
		>
	</a>
	<TextLink href="/contact">Zoiets nodig? Stuur me een bericht</TextLink>
</div>

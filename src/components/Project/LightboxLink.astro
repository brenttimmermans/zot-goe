---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	number: number;
	total: number;
	class?: string;
}

const MAX_WIDTH = 2400;

const { src, alt, number, total, class: className } = Astro.props;

const full = await getImage({
	src,
	width: Math.min(MAX_WIDTH, src.width),
	format: 'webp',
});
---

<a
	href={full.src}
	data-astro-prefetch="false"
	class:list={['glightbox block cursor-zoom-in', className]}
	data-gallery="project"
	data-alt={alt}
	aria-label={`Vergroot foto ${number} van ${total}: ${alt}`}
>
	<slot />
</a>

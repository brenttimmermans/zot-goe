---
import 'glightbox/dist/css/glightbox.min.css';

interface Props {
	order?: 'source' | 'screen';
}

const { order = 'source' } = Astro.props;
---

<div hidden data-lightbox-order={order}></div>

<script>
	import GLightbox from 'glightbox';

	const BUTTON_LABELS: Record<string, string> = {
		'.gclose': 'Sluiten',
		'.gprev': 'Vorige foto',
		'.gnext': 'Volgende foto',
	};

	const links = [...document.querySelectorAll<HTMLAnchorElement>('.glightbox')];
	const sortsByScreen = Boolean(
		document.querySelector('[data-lightbox-order="screen"]'),
	);
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// An empty list stops GLightbox binding the links itself, so the click
	// handler can pass the slides in its own order.
	const lightbox = GLightbox({
		elements: [],
		touchNavigation: true,
		loop: true,
		openEffect: reducedMotion ? 'none' : 'zoom',
		closeEffect: reducedMotion ? 'none' : 'zoom',
		slideEffect: reducedMotion ? 'none' : 'slide',
	});

	// GLightbox leaves focus behind the dialog, never restores it on close and
	// labels its buttons in English, so the open and close hooks fill that in.
	let opener: HTMLElement | undefined;

	const handleLinkClick = (event: MouseEvent): void => {
		if (!(event.currentTarget instanceof HTMLAnchorElement)) return;

		event.preventDefault();
		opener = event.currentTarget;

		const ordered = sortsByScreen ? links.toSorted(byScreenPosition) : links;
		lightbox.setElements(ordered.map(toSlide));
		lightbox.openAt(ordered.indexOf(event.currentTarget));
	};

	for (const link of links) {
		link.addEventListener('click', handleLinkClick);
	}

	lightbox.on('open', () => {
		for (const [selector, label] of Object.entries(BUTTON_LABELS)) {
			document.querySelector(selector)?.setAttribute('aria-label', label);
		}

		document.querySelector<HTMLElement>('.glightbox-container')?.focus();
	});
	lightbox.on('close', () => opener?.focus());

	function byScreenPosition(first: HTMLElement, second: HTMLElement): number {
		const firstBox = first.getBoundingClientRect();
		const secondBox = second.getBoundingClientRect();

		return (
			Math.round(firstBox.top - secondBox.top) || firstBox.left - secondBox.left
		);
	}

	function toSlide(link: HTMLAnchorElement): Record<string, string> {
		return { href: link.href, type: 'image', alt: link.dataset.alt ?? '' };
	}
</script>

<style is:global>
	.glightbox-clean.glightbox-container .goverlay {
		background: hsl(from var(--color-bg) h s l / 0.96);
	}

	.glightbox-clean.glightbox-container .gslide-media {
		box-shadow: none;
	}

	.glightbox-clean.glightbox-container .gbtn,
	.glightbox-clean.glightbox-container .gbtn:hover {
		background-color: hsl(from var(--color-bg) h s l / 0.8);
	}

	.glightbox-clean.glightbox-container .gbtn path {
		fill: var(--color-ink);
	}

	.glightbox-clean.glightbox-container .gbtn:hover path {
		fill: var(--color-accent);
	}

	.glightbox-clean.glightbox-container .gbtn.focused {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.glightbox-clean.glightbox-container .gloader {
		border-color: var(--color-ink);
		border-right-color: transparent;
	}
</style>

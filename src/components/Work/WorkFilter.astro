---
import { CATEGORY_LABELS, Category } from '~/constants/categories';
import type { Project } from '~/lib/projects';

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
const categories = Object.values(Category).filter((category) =>
	projects.some((project) => project.data.category === category),
);
---

<div
	role="group"
	aria-label="Filter op categorie"
	class="flex flex-wrap gap-x-5.5 gap-y-2 text-sm text-muted"
	data-work-filter
	hidden
>
	<button
		type="button"
		aria-pressed="true"
		class="cursor-pointer transition-colors hover:text-accent aria-pressed:text-ink"
		data-filter=""
	>
		Alles
	</button>
	{
		categories.map((category) => (
			<button
				type="button"
				aria-pressed="false"
				class="cursor-pointer transition-colors hover:text-accent aria-pressed:text-ink"
				data-filter={category}
			>
				{CATEGORY_LABELS[category]}
			</button>
		))
	}
</div>

<script>
	import { getWorkSlots } from '~/lib/workGrid';

	const FILTER_PARAM = 'categorie';

	const group = document.querySelector<HTMLElement>('[data-work-filter]');
	const buttons = [
		...document.querySelectorAll<HTMLButtonElement>('[data-work-filter] button'),
	];
	const items = [
		...document.querySelectorAll<HTMLLIElement>('[data-work-grid] > li'),
	];

	function showCategory(category: string): void {
		for (const button of buttons) {
			const isPressed = button.dataset.filter === category;
			button.setAttribute('aria-pressed', String(isPressed));
		}

		const visible = items.filter(
			(item) => !category || item.dataset.category === category,
		);
		for (const item of items) item.hidden = !visible.includes(item);

		const slots = getWorkSlots(visible.length);
		visible.forEach((item, index) => {
			const { span, height, centred } = slots[index];
			item.dataset.span = String(span);
			item.dataset.height = height;
			item.toggleAttribute('data-centred', Boolean(centred));
		});
	}

	function writeCategoryToUrl(category: string): void {
		const url = new URL(window.location.href);
		if (category) url.searchParams.set(FILTER_PARAM, category);
		else url.searchParams.delete(FILTER_PARAM);
		history.replaceState(history.state, '', url);
	}

	function readCategoryFromUrl(): string {
		const category = new URLSearchParams(window.location.search).get(
			FILTER_PARAM,
		);
		const isKnown = buttons.some(
			(button) => button.dataset.filter === category,
		);

		return isKnown && category ? category : '';
	}

	const handleFilterClick = (event: MouseEvent): void => {
		if (!(event.currentTarget instanceof HTMLButtonElement)) return;

		const category = event.currentTarget.dataset.filter ?? '';
		showCategory(category);
		writeCategoryToUrl(category);
	};

	for (const button of buttons) {
		button.addEventListener('click', handleFilterClick);
	}
	showCategory(readCategoryFromUrl());
	if (group) group.hidden = false;
</script>

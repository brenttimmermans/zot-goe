---
import Photo from '~/components/Common/Photo.astro';
import ContactForm from '~/components/Contact/ContactForm.astro';
import { CITY, EMAIL, OWNER, SITE_URL } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CONTACT_IMAGE } from '~/lib/siteImages';

const description =
	'Vertel me over je concert, event, huwelijk of raceweekend. Ik antwoord meestal binnen 24 uur.';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: 'Contact',
	description,
	url: new URL('/contact', SITE_URL).href,
	mainEntity: {
		'@type': 'Person',
		name: OWNER,
		email: EMAIL,
		address: {
			'@type': 'PostalAddress',
			addressLocality: CITY,
			addressCountry: 'BE',
		},
	},
};
---

<BaseLayout title="Contact" {description} {structuredData}>
	<div
		class="grid items-start gap-3 pb-section-L md:grid-cols-[5fr_7fr] md:px-gutter lg:grid-cols-[1fr_2fr]"
	>
		<Photo
			src={CONTACT_IMAGE}
			alt=""
			sizes="(min-width: 1024px) 33vw, 42vw"
			class="hidden aspect-portrait md:block"
		/>
		<div
			class="box-content flex max-w-copy flex-col gap-9 px-gutter pt-8 md:px-10 md:pt-10"
		>
			<div class="flex flex-col gap-3.5">
				<h1 class="text-heading font-medium">Vertel me erover</h1>
				<p class="font-serif text-prose text-pretty text-body">
					Een concert, een opening, een huwelijk of een raceweekend: vertel me
					wanneer, waar en wat voor shoot het wordt. Ik antwoord meestal binnen
					24 uur.
				</p>
			</div>
			<ContactForm />
		</div>
	</div>
</BaseLayout>

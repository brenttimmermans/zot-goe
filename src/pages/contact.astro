---
import Photo from '~/components/Common/Photo.astro';
import ContactForm from '~/components/Contact/ContactForm.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { CONTACT_IMAGE } from '~/lib/siteImages';
---

<BaseLayout title="Contact">
	<div
		class="grid items-start gap-media pb-section-L md:grid-cols-[5fr_7fr] md:px-media"
	>
		<Photo
			src={CONTACT_IMAGE}
			alt=""
			sizes="42vw"
			class="hidden aspect-[3/4] md:block"
		/>
		<div class="flex max-w-copy flex-col gap-9 px-gutter pt-8 md:px-10 md:pt-10">
			<div class="flex flex-col gap-3.5">
				<h1 class="text-heading font-medium">Vertel me erover</h1>
				<p class="font-serif text-prose text-pretty text-body">
					Een concert, een opening, een huwelijk of een raceweekend. Vermeld
					zeker de datum, het soort shoot en de locatie. Ik antwoord meestal
					binnen 24 uur.
				</p>
			</div>
			<ContactForm />
		</div>
	</div>
</BaseLayout>

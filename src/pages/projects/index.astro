---
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_URL } from '../../config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedProjects } from '../../lib/projects';

const projects = await getSortedProjects();

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Werk — Zot Goe',
	url: `${SITE_URL}/projects`,
};
---

<BaseLayout title="Werk" structuredData={structuredData}>
  <section class="mx-auto max-w-7xl px-page py-12 md:py-16">
    <h1 class="text-display font-extrabold uppercase text-heading">Werk</h1>
    <div class="mt-section grid gap-grid md:grid-cols-2 lg:gap-16">
      {
        projects.map((project, index) => (
          <ProjectCard project={project} index={index} metaStyle="stacked" />
        ))
      }
    </div>
  </section>
</BaseLayout>

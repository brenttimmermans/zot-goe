---
import ProcessSteps from '~/components/About/ProcessSteps.astro';
import Photo from '~/components/Common/Photo.astro';
import { EMAIL, OWNER, SINCE, SITE_NAME } from '~/config';
import { SOCIALS } from '~/constants/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PORTRAIT } from '~/lib/siteImages';

const DESCRIPTION = `${OWNER} fotografeert concerten, events, motorsport en huwelijken in en rond Gent. Sinds 2017 achter de camera, sinds ${SINCE} als ${SITE_NAME}.`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	mainEntity: {
		'@type': 'Person',
		name: OWNER,
		jobTitle: 'Fotograaf',
		email: EMAIL,
		sameAs: SOCIALS.map(({ href }) => href),
	},
};
---

<BaseLayout
	title="Over"
	description={DESCRIPTION}
	image={PORTRAIT}
	{structuredData}
>
	<section
		class="grid items-start gap-3 md:grid-cols-[5fr_7fr] md:px-gutter lg:grid-cols-[1fr_2fr]"
	>
		<Photo
			src={PORTRAIT}
			alt="Portret van Brent Timmermans"
			sizes="(min-width: 1024px) 33vw, (min-width: 768px) 42vw, 100vw"
			fit="cover"
			class="mx-gutter aspect-portrait md:mx-0"
			priority
		/>
		<div
			class="box-content flex max-w-copy flex-col gap-4 px-gutter pt-8 md:px-10 md:pt-10"
		>
			<h1 class="text-heading font-medium">Dag, ik ben Brent</h1>
			<div
				class="flex flex-col gap-4 font-serif text-prose leading-[1.7] text-body text-pretty"
			>
				<p>
					Ik fotografeer al zolang ik me kan herinneren, maar in 2017 werd het
					menens: van mijn eerste loon kocht ik een camera. Alles wat ik
					kan, heb ik mezelf aangeleerd.
				</p>
				<p>
					Sindsdien sta ik op concerten, boekvoorstellingen, expo's en
					huwelijken, en zo vaak als ik kan in Spa, tussen de paddock en de
					tribunes. Wat me telkens weer boeit, is wat er net vóór of net ná het
					grote moment gebeurt.
				</p>
			</div>
		</div>
	</section>
	<ProcessSteps />
</BaseLayout>

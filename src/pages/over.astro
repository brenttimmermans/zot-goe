---
import ProcessSteps from '~/components/About/ProcessSteps.astro';
import Photo from '~/components/Common/Photo.astro';
import { EMAIL, OWNER, SINCE } from '~/config';
import { SOCIALS } from '~/constants/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { PORTRAIT } from '~/lib/siteImages';

const DESCRIPTION = `${OWNER} fotografeert sinds ${SINCE} concerten, events, motorsport en huwelijken, in en rond Gent.`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	mainEntity: {
		'@type': 'Person',
		name: OWNER,
		jobTitle: 'Fotograaf',
		email: EMAIL,
		sameAs: SOCIALS.map(({ href }) => href),
	},
};
---

<BaseLayout
	title="Over"
	description={DESCRIPTION}
	image={PORTRAIT}
	{structuredData}
>
	<section class="grid items-start gap-media px-media md:grid-cols-2">
		<Photo
			src={PORTRAIT}
			alt="Portret van Brent Timmermans"
			sizes="(min-width: 768px) 50vw, 100vw"
			fit="cover"
			class="aspect-portrait"
			priority
		/>
		<div
			class="box-content flex max-w-[32.5rem] flex-col gap-[18px] px-gutter pt-8 md:px-0 md:pt-10 md:pr-4 md:pl-10"
		>
			<h1 class="text-heading font-medium">Dag, ik ben Brent</h1>
			<div
				class="flex flex-col gap-4 font-serif text-prose leading-[1.7] text-body text-pretty"
			>
				<p>
					Ik fotografeer al zolang ik me kan herinneren, maar in 2017 werd het
					menens: van mijn eerste loon kocht ik een deftige camera. Alles wat ik
					ken, heb ik mezelf aangeleerd.
				</p>
				<p>
					Sindsdien sta ik op concerten, boekvoorstellingen, expo's, huwelijken
					en aan de pitmuur op Spa. Wat me telkens trekt is het moment net vóór
					of net ná waar iedereen naar kijkt.
				</p>
				<p>
					Ik werk discreet, meestal zonder flits, en ik heb altijd een camera
					bij.
				</p>
			</div>
		</div>
	</section>
	<ProcessSteps />
</BaseLayout>

---
import AboutTeaser from '~/components/Home/AboutTeaser.astro';
import FeaturedProjects from '~/components/Home/FeaturedProjects.astro';
import Highlights from '~/components/Home/Highlights.astro';
import { CITY, EMAIL, OWNER, SITE_NAME, SITE_URL } from '~/config';
import { SOCIALS } from '~/constants/site';
import BaseLayout from '~/layouts/BaseLayout.astro';

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
		{
			'@type': 'Person',
			name: OWNER,
			jobTitle: 'Fotograaf',
			address: {
				'@type': 'PostalAddress',
				addressLocality: CITY,
				addressCountry: 'BE',
			},
			email: EMAIL,
			sameAs: SOCIALS.map(({ href }) => href),
		},
	],
};
---

<BaseLayout structuredData={structuredData}>
	<Highlights />
	<FeaturedProjects />
	<AboutTeaser />
</BaseLayout>

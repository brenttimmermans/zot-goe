---
import AboutTeaser from '~/components/Home/AboutTeaser.astro';
import FeaturedProjects from '~/components/Home/FeaturedProjects.astro';
import HeroCollage from '~/components/Home/HeroCollage.astro';
import { CITY, EMAIL, OWNER, SITE_NAME, SITE_URL, TAGLINE } from '~/config';
import { SOCIALS } from '~/constants/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { DEFAULT_OG_IMAGE } from '~/lib/siteImages';

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
		{
			'@type': 'Person',
			name: OWNER,
			jobTitle: 'Fotograaf',
			address: {
				'@type': 'PostalAddress',
				addressLocality: CITY,
				addressCountry: 'BE',
			},
			email: EMAIL,
			sameAs: SOCIALS.map(({ href }) => href),
		},
	],
};
---

<BaseLayout
	description={TAGLINE}
	image={DEFAULT_OG_IMAGE}
	structuredData={structuredData}
>
	<HeroCollage />
	<FeaturedProjects />
	<AboutTeaser />
</BaseLayout>

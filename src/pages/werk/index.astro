---
import WorkFilter from '~/components/Work/WorkFilter.astro';
import WorkGrid from '~/components/Work/WorkGrid.astro';
import { OWNER, SITE_URL } from '~/config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getProjects } from '~/lib/projects';

const DESCRIPTION = `Concerten, events, motorsport en huwelijken: alle projecten van ${OWNER}.`;

const projects = await getProjects();

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Werk',
	description: DESCRIPTION,
	url: new URL('/werk', SITE_URL).href,
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: projects.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: new URL(`/werk/${project.id}`, SITE_URL).href,
		})),
	},
};
---

<BaseLayout
	title="Werk"
	description={DESCRIPTION}
	structuredData={structuredData}
>
	<div
		class="flex flex-col gap-4 px-gutter pt-section-S pb-11 md:flex-row md:items-baseline md:justify-between"
	>
		<h1 class="text-heading font-medium">Werk</h1>
		<WorkFilter projects={projects} />
	</div>
	<WorkGrid projects={projects} />
</BaseLayout>
